{
    "version": "2.0.0",
    "options": {
        "cwd": "${workspaceFolder}/Transport_car",
        "env": {
            "PATH": "C:/Users/Shihva/AppData/Local/stm32cube/bundles/gnu-tools-for-stm32/14.3.1+st.2/bin;C:/Users/Shihva/AppData/Local/stm32cube/bundles/ninja/1.13.2+st.1/bin;C:/Users/Shihva/AppData/Local/stm32cube/bundles/cmake/4.3.1+st.1/bin;C:/Users/Shihva/AppData/Local/stm32cube/bundles/programmer/2.23.0/bin;${env:PATH}"
        }
    },
    "tasks": [
        {
            "label": "1. Configure (Debug)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--preset",
                "Debug"
            ],
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": false
            }
        },
        {
            "label": "2. Build (Debug)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "Debug"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                {
                    "owner": "cpp",
                    "source": "gcc",
                    "fileLocation": [
                        "autoDetect",
                        "${workspaceFolder}/Transport_car"
                    ],
                    "pattern": {
                        "regexp": "^(.*?):(\\d+):(\\d+):\\s+(warning|error|note):\\s+(.*)$",
                        "file": 1,
                        "line": 2,
                        "column": 3,
                        "severity": 4,
                        "message": 5
                    }
                }
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": false
            }
        },
        {
            "label": "3. Flash (ST-LINK)",
            "type": "shell",
            "command": "STM32_Programmer_CLI",
            "args": [
                "-c",
                "port=SWD",
                "mode=UR",
                "-w",
                "build/Debug/Transport_car.elf",
                "-v",
                "-rst"
            ],
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": false
            }
        },
        {
            "label": "Build + Flash",
            "dependsOrder": "sequence",
            "dependsOn": [
                "2. Build (Debug)",
                "3. Flash (ST-LINK)"
            ],
            "group": "build",
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": false
            }
        }
    ]
}
